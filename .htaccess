Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:storage|scripts|tests)(?:/|$) - [F,L,NC]
RewriteRule ^api/(?!chat(?:\.php)?$|contact(?:\.php)?$|health(?:\.php)?$) - [F,L,NC]
RewriteRule \.(?:env|ini|ndjson|log|bak|sql|md|mjs)$ - [F,L,NC]
RewriteRule ^router\.php$ - [F,L,NC]

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always unset X-Powered-By

<FilesMatch "\.(?:html?)$">
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>

<FilesMatch "\.(?:css|js|mjs|json)$">
Header set Cache-Control "no-cache, must-revalidate, max-age=0"
</FilesMatch>

<FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico|woff2?|ttf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
